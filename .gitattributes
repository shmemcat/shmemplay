* text=auto

*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary

# Contract inputs and golden outputs are exact bytes. Never normalize their
# line endings or encodings, even when a fixture has a text-like extension.
contract-fixtures/** -text
